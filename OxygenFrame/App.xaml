<Application x:Class="OxygenFrame.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Startup="Application_Startup">
 <Application.Resources>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#F21C2029"/>
  <SolidColorBrush x:Key="CardBrush" Color="#FF252B36"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#FFB9F36B"/>
  <SolidColorBrush x:Key="TextBrush" Color="#FFF4F6FA"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA4B4"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="#FF343C4B"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Application.Resources>
</Application>
